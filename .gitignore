*.png
*.jpg
*.jpeg
# Secrets — .env.local holds live API tokens (Instagram, LinkedIn) and AWS keys.
# It was untracked but NOT ignored, so a single `git add -A` would have published them.
.env.local
.env
# The admin's ☁ Publish password + AWS target (see plot-map/publish.config.example.json).
plot-map/publish.config.json

# Build artefacts and downloaded tools — not source
__pycache__/
plot-map/cloudflared.exe
plot-map/tools/*
# …except the script that regenerates vendor/3d-tiles-renderer-*/ and friends (GoogleEarthView.md §9).
# (`tools/*` rather than `tools/`: git can't re-include a file inside an ignored directory.)
!plot-map/tools/vendor_3d_tiles.py

# Project data is NOT source code and never goes into git (2026-09-27, on request). Every project's
# working files live in S3 (ZEROX-PROJECTS-FINAL/<id>/) and plot-map/projects/ is only this
# machine's working copy, filled and uploaded by the admin — see plot-map/ADMIN-DATA-SYNC.md.
# This one rule also covers what used to need its own line: big media, _originals/, the
# per-machine .b91-sync.json record, half-downloaded *.part files.
plot-map/projects/

# The admin usage log (server.py → usage-log.csv; summarise with usage_report.py). Per machine.
plot-map/usage-log.csv
plot-map/LINKS.txt
plot-map/*.log
