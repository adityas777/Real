{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "ListTheSitesBucket",
      "Effect": "Allow",
      "Action": ["s3:ListBucket"],
      "Resource": "arn:aws:s3:::re.build91.in"
    },
    {
      "Sid": "ReadWriteProjectsAndPublishedSites",
      "Effect": "Allow",
      "Action": ["s3:GetObject", "s3:PutObject", "s3:DeleteObject"],
      "Resource": "arn:aws:s3:::re.build91.in/*"
    },
    {
      "Sid": "RefreshCloudFrontAfterPublish",
      "Effect": "Allow",
      "Action": ["cloudfront:CreateInvalidation", "cloudfront:GetInvalidation"],
      "Resource": "arn:aws:cloudfront::ACCOUNT_ID:distribution/ESB5IEEO3UHEP"
    }
  ]
}
